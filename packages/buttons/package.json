{
  "name": "@buscacode/buttons",
  "version": "0.0.0",
  "description": "A simple button",
  "keywords": [
    "buscacode",
    "button"
  ],
  "author": "Wilder Trujillo <nadie437@gmail.com>",
  "homepage": "https://github.com/wilder00/buscacode-devx",
  "sideEffects": true,
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:original": "rimraf dist && tsup src/index.ts --dts",
    "build": "rimraf dist && vite build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilder00/buscacode-devx.git",
    "directory": "packages/buttons"
  },
  "bugs": {
    "url": "https://github.com/wilder00/buscacode-devx/issues"
  },
  "directories": {
    "doc": "docs",
    "packages": "packages"
  },
  "engines": {
    "node": ">=20.0"
  },
  "dependencies": {
    "@buscacode/base-styles": "workspace:*",
    "@buscacode/icons": "workspace:*",
    "@buscacode/tailwind-utils": "workspace:*",
    "clsx": "2.1.1"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "20.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vanilla-extract/css": "1.17.5",
    "@vanilla-extract/recipes": "0.5.7",
    "@vanilla-extract/vite-plugin": "5.1.3",
    "@vitejs/plugin-react": "5.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "7.2.6",
    "vite-plugin-dts": "4.5.4"
  }
}
