{
  "name": "@buscacode/buttons",
  "version": "0.0.0",
  "description": "A simple button",
  "keywords": [
    "buscacode",
    "button"
  ],
  "author": "Wilder Trujillo <nadie437@gmail.com>",
  "homepage": "https://github.com/wilder00/buscacode-devx",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "publishConfig": {
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style": "./dist/index.css",
    "./tailwind-style": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:original": "rimraf dist && tsup src/index.ts --dts",
    "build": "rimraf dist && tsc -b && vite build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilder00/buscacode-devx.git",
    "directory": "packages/buttons"
  },
  "bugs": {
    "url": "https://github.com/wilder00/buscacode-devx/issues"
  },
  "directories": {
    "doc": "docs",
    "packages": "packages"
  },
  "engines": {
    "node": ">=20.0"
  },
  "dependencies": {
    "@buscacode/base-styles": "workspace:*",
    "@buscacode/icons": "workspace:*",
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "@vanilla-extract/css": "1.17.5",
    "@vanilla-extract/vite-plugin": "5.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "7.2.6",
    "vite-plugin-dts": "4.5.4"
  }
}
