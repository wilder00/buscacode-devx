{
  "name": "@buscacode/icons",
  "version": "0.0.0",
  "description": "Showing icons",
  "keywords": [
    "buscacode",
    "icons"
  ],
  "author": "Wilder Trujillo <nadie437@gmail.com>",
  "homepage": "https://github.com/wilder00/buscacode-devx",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:original": "rimraf dist && svgr -- src/assets && pnpm run format:fix && pnpm run lint:fix && tsup src --dts",
    "build": "rimraf dist && svgr -- src/assets && generate:iconMaps && pnpm run format:fix && pnpm run lint:fix && vite build",
    "format:fix": "prettier --write ./src",
    "lint:fix": "eslint ./src -c ../../eslint.config.mjs --fix",
    "generate:iconMaps": "tsx ./src/generate/generateIconMaps.ts &&"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilder00/buscacode-devx.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/wilder00/buscacode-devx/issues"
  },
  "directories": {
    "doc": "docs",
    "packages": "packages"
  },
  "engines": {
    "node": ">=18.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@svgr/cli": "8.1.0",
    "@vitejs/plugin-react": "5.1.2",
    "vite-plugin-dts": "4.5.4"
  }
}
