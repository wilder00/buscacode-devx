{
  "name": "buscacode-devx",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:analyze": "react-router build --mode analyze",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint",
    "lint:fix": "eslint . -c eslint.config.mjs --fix",
    "lint:check": "eslint . -c eslint.config.mjs --no-fix",
    "format:fix": "prettier --ignore-path .prettierignore --write .",
    "format:check": "prettier --ignore-path .prettierignore --check .",
    "format:watch": "onchange \"**/*\" -- prettier --write --ignore-path .prettierignore --ignore-unknown {{changed}}",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:show": "http-server -c-1 -o ./coverage/index.html -p 6001",
    "coverage:show-lcov": "http-server -c-1 -o ./coverage/lcov-report/index.html -p 6001",
    "coverage:verify-lcov": "lcov-total ./coverage/lcov.info && lcov-total ./coverage/lcov.info --gte=50",
    "prepare": "husky",
    "build:packages": "lerna run build",
    "publish:packages": "lerna run build && pnpm run test && lerna publish"
  },
  "dependencies": {
    "@buscacode/base-styles": "workspace:*",
    "@buscacode/buttons": "workspace:*",
    "@buscacode/chips": "workspace:*",
    "@buscacode/devx-utils": "workspace:*",
    "@buscacode/icons": "workspace:*",
    "@buscacode/inputs": "workspace:*",
    "@buscacode/selectable": "workspace:*",
    "@buscacode/selects": "workspace:*",
    "@buscacode/tailwind-utils": "workspace:*",
    "@monaco-editor/react": "4.7.0",
    "@react-router/node": "7.9.6",
    "@react-router/serve": "7.9.6",
    "isbot": "5.1.32",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-live": "4.1.8",
    "react-router": "7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@react-router/dev": "7.9.6",
    "@svgr/plugin-prettier": "8.1.0",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "20.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.48.0",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-istanbul": "4.0.14",
    "@vitest/coverage-v8": "4.0.14",
    "@vitest/eslint-plugin": "1.5.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.5.0",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "jsdom": "27.2.0",
    "lcov-total": "2.1.1",
    "lerna": "9.0.3",
    "onchange": "7.1.0",
    "prettier": "3.7.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "rimraf": "6.1.2",
    "rollup-plugin-visualizer": "6.0.5",
    "tailwindcss": "4.1.17",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.2.6",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.0.14"
  },
  "overrides": {
    "eslint": "9.39.1"
  },
  "resolutions": {
    "@types/react": "19.2.7"
  },
  "engines": {
    "node": ">=20.0"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
